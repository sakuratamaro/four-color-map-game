{
  "expo": {
    "name": "Four Color Map Game",
    "slug": "four-color-map-game",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "fourcolormap",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "android": {
      "package": "com.example.fourcolormapgame"
    },
    "ios": {
      "bundleIdentifier": "com.example.fourcolormapgame"
    }
  }
}
